# Same Postgres pooler URL as aqademiq-backend (Supabase).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:6543/postgres

# Shared password for investor login.
INVESTOR_DASHBOARD_PASSWORD=change-me

# Long random string used to sign the session cookie.
SESSION_SECRET=replace-with-a-long-random-string
